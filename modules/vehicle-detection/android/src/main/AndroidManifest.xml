<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    ההרשאה לזיהוי תנועה. שתי השורות נחוצות:
    הראשונה למכשירים עם אנדרואיד 9 ומטה, השנייה לאנדרואיד 10 ומעלה
    (שם זו הרשאה שצריך לבקש מהמשתמש בזמן ריצה, לא רק להצהיר עליה).
    שים לב: אין כאן שום הרשאת מיקום - הזיהוי מבוסס על חיישן התאוצה בלבד.
  -->
  <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION" />
  <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

  <!-- נדרש כדי להציג התראה מהקוד הנייטיב באנדרואיד 13 ומעלה. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!--
    נדרש כדי לרשום מחדש את זיהוי התנועה אחרי הפעלה מחדש של הטלפון.
    בלי זה ההגנה האוטומטית נכבית בשקט בכל אתחול.
  -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <!--
    ההסלמה לאיש קשר: שיחה אם ההורה לא אישר שראה את ההתראות.
    CALL_PHONE - השיחה עצמה. USE_FULL_SCREEN_INTENT - מסך הספירה מעל
    מסך הנעילה. SCHEDULE_EXACT_ALARM - שהשיחה תצא בזמן ולא "בערך".
  -->
  <uses-permission android:name="android.permission.CALL_PHONE" />
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
  <uses-permission android:name="android.permission.VIBRATE" />

  <application>
    <!--
      המקלט שגוגל מעירה כשמתרחש מעבר בין מצבי תנועה.
      הוא מוצהר כאן במניפסט (ולא נרשם מתוך הקוד בזמן ריצה) - וזה קריטי:
      מקלט שמוצהר במניפסט ממשיך לעבוד גם אחרי שהמשתמש סגר את האפליקציה
      לגמרי, כי המערכת מפעילה תהליך חדש רק בשבילו. מקלט שנרשם בזמן ריצה
      היה מת יחד עם האפליקציה - ואז ההורה שסוגר אפליקציות לא היה מקבל
      כלום, וזה בדיוק ההורה שהכי צריך את זה.

      exported="true" נדרש כי מי ששולח את השידור הוא Google Play Services,
      תהליך חיצוני לאפליקציה שלנו.

      שם המחלקה כתוב במלואו ולא כ-".VehicleTransitionReceiver" בכוונה:
      שם יחסי במניפסט של ספרייה מורחב בזמן המיזוג לפי שם החבילה של
      *האפליקציה* ולא של הספרייה. כלומר הוא היה הופך ל-
      com.kidscarsafety.app.VehicleTransitionReceiver - מחלקה שלא קיימת,
      והמקלט פשוט לא היה נקרא כשגוגל מזהה יציאה מרכב.
    -->
    <receiver
      android:name="com.kidscarsafety.vehicledetection.VehicleTransitionReceiver"
      android:exported="true"
      android:enabled="true" />

    <!--
      מעיר אותנו אחרי הפעלה מחדש של הטלפון, כדי לרשום מחדש את זיהוי
      התנועה. הרישום מול Google Play Services לא שורד אתחול, ובלי
      המקלט הזה ההורה נשאר בלי הגנה עד שיפתח את האפליקציה בעצמו.
    -->
    <receiver
      android:name="com.kidscarsafety.vehicledetection.BootReceiver"
      android:exported="true"
      android:enabled="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>

    <receiver
      android:name="com.kidscarsafety.vehicledetection.EscalationReceiver"
      android:exported="false" />

    <!--
      מסך הספירה לאחור. מוצג מעל מסך הנעילה (showWhenLocked) ומדליק את
      המסך (turnScreenOn), כמו שעון מעורר. משימה נפרדת (taskAffinity ריק)
      כדי שלא יתערבב עם האפליקציה הרגילה וישאיר אחריו מסך תקוע.
    -->
    <activity
      android:name="com.kidscarsafety.vehicledetection.CountdownActivity"
      android:exported="false"
      android:showWhenLocked="true"
      android:turnScreenOn="true"
      android:excludeFromRecents="true"
      android:launchMode="singleInstance"
      android:taskAffinity=""
      android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" />
  </application>

</manifest>
